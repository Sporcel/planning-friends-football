{
  "expo": {
    "name": "Planning Friends Football",
    "slug": "sporcel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sporcel",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.sporcel.app"
    },
    "android": {
      "package": "com.sporcel.app",
      "adaptiveIcon": {
        "backgroundColor": "#1B7F3B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B7F3B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Planning Friends Football necesita acceder a tus fotos para poner la foto de los jugadores.",
          "cameraPermission": "Planning Friends Football necesita la cámara para hacer la foto de los jugadores."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fe3f8cb5-0683-4346-be26-69bb25d3980b"
      }
    }
  }
}
